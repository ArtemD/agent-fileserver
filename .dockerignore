# Keep the build context to the Go module. Plain excludes only: a "!" re-include
# would make Docker walk excluded directories, and data/ is private to UID 10001.
.git
.github
.env
.env.*
data
logs
deploy
docs
scripts
tests
*.md
*_test.go
compose*.yaml
Dockerfile
.dockerignore
.gitignore
LICENSE
agent-fileserver
