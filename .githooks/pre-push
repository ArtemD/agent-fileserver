#!/bin/sh
# Refuse to publish commits that fail scripts/check_commits.py, including that each
# referenced issue exists on GitHub and fills an issue form. CI repeats this check.
# Enable once per clone: git config core.hooksPath .githooks
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac # branch deletion
	case "$remote_sha" in
	*[!0]*) set -- "$remote_sha..$local_sha" ;;
	*) set -- "$local_sha" --not --remotes ;; # new branch: only unpublished commits
	esac
	python3 scripts/check_commits.py --verify-issues -- "$@" || status=1
done
exit $status
