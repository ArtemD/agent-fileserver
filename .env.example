# Copy to .env and edit. .env is git-ignored. It holds configuration only:
# agent keys are never stored here (the server keeps only their hashes in the
# data directory; create them with `docker compose run --rm admin token create`).

# Public hostname visitors and agents use (no scheme, no path).
FSERVER_DOMAIN=files.example.com

# proxy  = a trusted HTTPS frontend forwards plain HTTP to FSERVER_LISTEN (exe.dev, Cloudflare Tunnel, …)
# direct = use compose.direct.yaml; Caddy serves 80/443 and gets certificates itself
FSERVER_MODE=proxy

# Host address for proxy mode. Keep it on loopback unless the frontend is elsewhere.
FSERVER_LISTEN=127.0.0.1:8000

# Host directories (bind mounts). Back these up; data holds releases, policies and key hashes.
FSERVER_DATA_DIR=./data
FSERVER_LOG_DIR=./logs

# Optional
# FSERVER_NAMESPACE=default
# Change only if these clash with a network on this host; the gateway must be inside the subnet.
# FSERVER_EDGE_SUBNET=172.30.53.0/24
# FSERVER_EDGE_GATEWAY=172.30.53.1
# FSERVER_EDGE_SUBNET6=fd53:ac1e:3500::/64
# COMPOSE_FILE=compose.yaml:compose.direct.yaml
