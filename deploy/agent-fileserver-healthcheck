#!/bin/sh
# Root-owned health probe. Never revive services intentionally stopped by an owner.
set -eu
active() { /usr/bin/systemctl is-active --quiet "$1"; }
restart_if_active() {
    echo "agent-fileserver: $1 health failed; try-restart only if still active" >&2
    /usr/bin/systemctl try-restart "$1"
}
if active agent-fileserver-api.service; then
    if ! /usr/bin/curl -q --noproxy '*' --silent --fail --max-time 3 \
        --output /dev/null --unix-socket /run/agent-fileserver-api/http.sock \
        http://localhost/_internal/health; then
        restart_if_active agent-fileserver-api.service
    fi
fi
if active agent-fileserver.service; then
    if [ "$FSERVER_MODE" = direct ]; then
        # Probe only cleartext routing/redirect readiness. Do not trigger ACME,
        # require DNS resolution, or treat pending certificate issuance as failure.
        host=${FSERVER_BASE_URL#https://}
        status=$(/usr/bin/curl -q --noproxy '*' --silent --max-time 3 \
            --header "Host: $host" --output /dev/null --write-out '%{http_code}' \
            http://127.0.0.1/) || status=000
        case "$status" in 308|404) ;; *) restart_if_active agent-fileserver.service ;; esac
    else
        case "$FSERVER_LISTEN" in
            :*) address="127.0.0.1$FSERVER_LISTEN" ;;
            0.0.0.0:*) address="127.0.0.1:${FSERVER_LISTEN##*:}" ;;
            '[::]':*) address="[::1]:${FSERVER_LISTEN##*:}" ;;
            *) address=$FSERVER_LISTEN ;;
        esac
        status=$(/usr/bin/curl -q --noproxy '*' --silent --max-time 3 \
            --output /dev/null --write-out '%{http_code}' "http://$address/") || status=000
        if [ "$status" != 404 ]; then restart_if_active agent-fileserver.service; fi
    fi
fi
