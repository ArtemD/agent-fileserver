# Direct mode: Caddy obtains and renews certificates for FSERVER_DOMAIN itself.
# It binds 80/443 inside the container (the image's file capability allows it)
# so redirects and HTTP/3 advertise the real ports. No forwarded headers are trusted.
{
	admin off
	persist_config off
	storage file_system /data/caddy
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$FSERVER_DOMAIN} {
	import routes.caddy
}

# Loopback-only health endpoint, so compose's healthcheck is the same in both modes.
http://127.0.0.1:8000 {
	bind 127.0.0.1
	respond /robots.txt "User-agent: *\nDisallow: /\n" 200
	respond "Not Found" 404
}
