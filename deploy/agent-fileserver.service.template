[Unit]
Description=Public static file server (Caddy)
Documentation=https://caddyserver.com/docs/
After=network-online.target agent-fileserver-api.service
Wants=network-online.target

[Service]
Type=notify
User=afs-caddy
Group=afs-caddy
ExecStart=/usr/local/libexec/agent-fileserver-caddy run --config /etc/agent-fileserver/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
LimitNOFILE=65536
UMask=0077
LogsDirectory=agent-fileserver
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=@CAPABILITIES@
AmbientCapabilities=@CAPABILITIES@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
StateDirectory=agent-fileserver-caddy
StateDirectoryMode=0700
Environment=HOME=/var/lib/agent-fileserver-caddy
ReadWritePaths=/var/lib/agent-fileserver-caddy /var/log/agent-fileserver
ReadOnlyPaths=/var/lib/agent-fileserver
InaccessiblePaths=/var/lib/agent-fileserver/staging /var/lib/agent-fileserver/manifests /var/lib/agent-fileserver/trash /var/lib/agent-fileserver/policies /var/lib/agent-fileserver/credentials /var/lib/agent-fileserver/incoming /var/lib/agent-fileserver/api-state
MemoryMax=512M
TasksMax=128
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
