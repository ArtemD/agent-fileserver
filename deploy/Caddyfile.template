{
	admin off
@AUTO_HTTPS@
	persist_config off
	storage file_system {
		root /var/lib/agent-fileserver-caddy
	}
	servers {
@TRUSTED_PROXIES@
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

@SITE@ {
@BIND@
	root * /var/lib/agent-fileserver/public

	# All origin requests, without sampling. Keep bearer URLs/IPs private.
	log access {
		output file /var/log/agent-fileserver/access.json {
			mode 0600
			roll_size 20MiB
			roll_interval 24h
			roll_keep 14
			roll_keep_for 336h
		}
		format json
	}
	header -Server
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Cache-Control "no-store"
	}

	route {
		# Management is explicitly authenticated by the isolated Go service.
		# This route is deliberately before the read-only public-file rules.
		@management path /_api/v1 /_api/v1/* /mcp /mcp/*
		handle @management {
			request_body {
				max_size 140MiB
			}
			reverse_proxy unix//run/agent-fileserver-api/http.sock {
				# Never trust a caller-supplied identity header.
				header_up X-Fserver-Client-IP {client_ip}
				transport http {
					response_header_timeout 180s
				}
			}
		}

		# No internal authorization, policy, credential, or filesystem paths.
		@private path /_internal /_internal/* /credentials /credentials/* /policies /policies/* /staging /staging/* /manifests /manifests/* /incoming /incoming/* /api-state /api-state/* /trash /trash/*
		respond @private "Not Found" 404

		@write not method GET HEAD
		header @write Allow "GET, HEAD"
		respond @write "Method Not Allowed" 405

		@robots path /robots.txt
		header @robots Content-Type "text/plain; charset=utf-8"
		respond @robots 200 {
			body <<ROBOTS
				User-agent: *
				Disallow: /
				ROBOTS
		}

		# Defense in depth if someone bypasses the publishing CLI.
		@hidden path_regexp hidden "(?i)(^|/)\.[^/]*|\.(pem|key|p12|pfx|kdbx|keystore|map|php|php3|php4|php5|php7|php8|phtml|pht|phar|cgi|fcgi|pl|pm|py|pyc|pyo|rb|sh|bash|zsh|ps1)(/|$)"
		respond @hidden "Not Found" 404

		@release path_regexp release "^/([A-Za-z0-9_-]{22})(/|$)"
		handle @release {
			# A nested route is essential: normal directive sorting would move
			# headers/SPA rewrites before authorization.
			route {
				request_header -X-Fserver-Cache-Control
				# Every release has a private policy; missing policy fails closed.
				# This internal endpoint is NEVER proxied as a public route.
				forward_auth unix//run/agent-fileserver-api/http.sock {
					uri /_internal/authorize
					header_up X-Fserver-Client-IP {client_ip}
					copy_headers X-Fserver-Cache-Control
					transport http {
						response_header_timeout 10s
					}
				}
				# Default private. Only a precise, trusted public-policy answer
				# permits shared caching; caller-supplied helper headers are gone.
				header Cache-Control "private, no-store"
				@publiccache header X-Fserver-Cache-Control "public, max-age=3600"
				header @publiccache Cache-Control "public, max-age=3600"
				# Only explicitly opted-in releases have client-side route fallback.
				# Never fall back for a file-like path, missing asset, or directory.
				@spa {
					path_regexp sparoute "^/[A-Za-z0-9_-]{22}/([^./][^.]*)$"
					file /{re.release.1}/.fserver-spa
					not file {path} {path}/
				}
				rewrite @spa /{re.release.1}/index.html
				file_server {
					index index.html
					hide .*
					precompressed br gzip
				}
			}
		}
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	handle_errors {
		header Cache-Control "no-store"
		@toolarge expression {err.status_code} == 413
		respond @toolarge "Request body too large" 413
		@unavailable expression {err.status_code} >= 500
		respond @unavailable "Service temporarily unavailable" 503
		respond "Not Found" 404
	}
}
